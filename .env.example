# Local development: copy to .env.local and fill in from Supabase > Project Settings > API keys.
# Production builds read the public values from the committed .env.production instead.
# Secrets (if ever needed, e.g. a service_role key) go only in .env.local or the host's env vars.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret (Supabase > Project Settings > API keys > Secret key, sb_secret_...).
# Needed for inviting/removing team members. NEVER commit it or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Zernio (client Google Business Profile and social connections). Server only, never NEXT_PUBLIC_.
# API key: Zernio dashboard > API keys (full access).
ZERNIO_API_KEY=
# Any random string of 32+ characters (e.g. `openssl rand -hex 32`). Zernio signs webhooks with it.
ZERNIO_WEBHOOK_SECRET=

# Client onboarding link. Leave the two ONBOARDING_ values empty to use <app>/onboard/<link>.
# When the subdomain is ready: ONBOARDING_HOST=connect.leadmaker.agency and
# ONBOARDING_BASE_URL=https://connect.leadmaker.agency (plus the domain in DigitalOcean).
ONBOARDING_HOST=
ONBOARDING_BASE_URL=
# The Google service account email clients add to Search Console and GA4 (optional for now).
GOOGLE_REPORTING_EMAIL=
# The email clients invite to their website. Defaults to seo@leadmaker.agency.
AGENCY_ACCESS_EMAIL=
