# Local development: copy to .env.local and fill in from Supabase > Project Settings > API keys.
# Production builds read the public values from the committed .env.production instead.
# Secrets (if ever needed, e.g. a service_role key) go only in .env.local or the host's env vars.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret (Supabase > Project Settings > API keys > Secret key, sb_secret_...).
# Needed for inviting/removing team members. NEVER commit it or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
